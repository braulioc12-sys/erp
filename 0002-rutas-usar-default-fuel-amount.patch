-                "default_fuel_gallons = ?, active = 1 WHERE id = ?",
-                (amount, commission, gallons, existing["id"]),
+                "default_fuel_amount = ?, active = 1 WHERE id = ?",
+                (amount, commission, fuel_amount, existing["id"]),
