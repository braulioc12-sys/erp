       function update() {
         var actual = parseFloat(actualInput.value);
         if (isNaN(actual)) { hint.textContent = ''; return; }
         var diff = actual - expected;
         if (diff > 0.001) {
-          hint.textContent = 'Exceso sobre lo estimado: ' + diff.toFixed(2) + ' gal.';
+          hint.textContent = 'Exceso al guardar: ' + diff.toFixed(2) + ' gal (se calcula solo).';
           hint.style.color = 'var(--danger)';
