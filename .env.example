# Copia este archivo a .env y ajusta los valores para tu entorno.
SECRET_KEY=cambia-esta-clave-por-una-aleatoria-y-larga
COMPANY_NAME=Harraso Transport
# Ruta del archivo SQLite. Se usa solo si DATABASE_URL (más abajo) está
# vacía. En producción sin AWS usa un disco persistente (ver README).
DATABASE_PATH=instance/erp.db
# Pon en 1 solo si tu app corre detrás de HTTPS en producción.
SESSION_COOKIE_SECURE=0
# En 1 (por defecto), recrea automáticamente los usuarios/datos de ejemplo
# si la base de datos queda vacía (útil en hosting gratuito sin disco
# persistente). Ponlo en 0 cuando ya tengas datos reales del negocio —
# IMPRESCINDIBLE ponerlo en 0 al pasar a una base de datos persistente
# (disco de pago en Render, o RDS) para que un reinicio nunca reseed encima
# de datos reales.
AUTO_SEED_DEMO=1

# --- Base de datos persistente en AWS (RDS) — opcional, ver README sección
# "Base de datos persistente en AWS (RDS + S3)". Si se deja vacía, la app
# sigue usando SQLite en DATABASE_PATH exactamente como hasta ahora.
# Formato: postgresql://usuario:password@host:5432/nombre_basededatos
DATABASE_URL=

# --- Documentos en Amazon S3 (comprobantes de gastos) — opcional, mismo
# README. Si AWS_S3_BUCKET se deja vacío, los comprobantes se siguen
# guardando en disco local exactamente como hasta ahora.
AWS_S3_BUCKET=
# Credenciales del usuario IAM dedicado a este bucket (ver README — nunca
# uses las credenciales root de la cuenta AWS). boto3 las lee directo de
# estas variables de entorno estándar, no hace falta configurarlas en
# ningún otro lado del código.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Integración con Frotcom (GPS) — opcional. Ver README, sección
# "Integración con Frotcom (GPS)", para cómo obtener estas credenciales.
FROTCOM_BASE_URL=
FROTCOM_USERNAME=
FROTCOM_PASSWORD=

# Facturación electrónica SUNAT (facturas y guías de remisión) — opcional.
# Ver README, sección "Facturación electrónica (SUNAT)".
# RUTA y TOKEN los entrega tu OSE (NubeFacT, Efact, etc.) al crear tu cuenta.
OSE_RUTA=
OSE_TOKEN=
# RUC y dirección fiscal de TU empresa (el emisor de los comprobantes).
COMPANY_RUC=
COMPANY_ADDRESS=
# Series de comprobantes que hayas dado de alta en tu OSE/SUNAT.
INVOICE_SERIES=F001
WAYBILL_SERIES=T001

# decolecta.com: tipo de cambio SUNAT y consulta de RUC (autocompletar
# proveedor al registrar un gasto en Liquidaciones). El tipo de cambio
# funciona sin token; la consulta de RUC sí lo exige — regístrate gratis
# en https://decolecta.com y define DECOLECTA_TOKEN (1000 consultas/mes
# gratis, se comparte para ambos servicios). Ver README, sección
# "Liquidaciones".
DECOLECTA_BASE_URL=
DECOLECTA_RUC_BASE_URL=
DECOLECTA_TOKEN=
