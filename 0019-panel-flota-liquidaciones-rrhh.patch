+  {% else %}
+    {% if advance.fuel_excess %}
+    <p class="mt-0" style="color:var(--danger);">Esta liquidación registra un exceso de combustible de <strong>{{ '%.2f gal'|format(advance.fuel_excess) }}</strong> (ver "Consumo de combustible" arriba) — revísalo antes de aprobar.</p>
+    {% elif advance.fuel_actual is none %}
+    <p class="muted mt-0">Todavía no se registró el combustible real de este viaje (ver "Consumo de combustible" arriba).</p>
+    {% else %}
+    <p class="muted mt-0">Sin exceso de combustible registrado.</p>
+    {% endif %}
+    {% if is_admin %}
+    <form method="post" action="{{ url_for('liquidaciones.rrhh_approve', advance_id=advance.id) }}" onsubmit="return confirm('¿Dar el OK final y marcar esta liquidación como lista para enviarse a RRHH?');">
+      <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
+      <button type="submit" class="btn btn-primary">Dar OK y marcar lista para RRHH</button>
+    </form>
+    {% else %}
+    <p class="muted mt-0">Pendiente de la aprobación de un Administrador antes de poder enviarse a RRHH.</p>
+    {% endif %}
+  {% endif %}
+</div>
 {% endif %}
 
